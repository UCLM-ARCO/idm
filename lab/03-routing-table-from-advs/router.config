# -*- mode: conf; coding: utf-8 -*-

# Common Ice properties
Ice.ThreadPool.Client.SizeMax=10
Ice.ThreadPool.Server.SizeMax=10

# PyEndpoint support
Ice.Plugin.PyEndpoint = IcePyEndpoint:addPyEndpointSupport
PyEndpoint.Module = IceXBee
PyEndpoint.Factory = EndpointFactoryI

XBee.Service.Proxy = SerialHandler -t:tcp -h 127.0.0.1 -p 6141
XBee.ReaderAdapter.Endpoints = tcp -h 127.0.0.1

# IDM router settings
Router.Adapter.Endpoints = tcp -h 127.0.0.1 -p 6140 : xbee -p idm -n router
Router.Table.Path = router.table
