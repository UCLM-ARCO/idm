# -*- mode: conf; coding: utf-8 -*-

Ice.Plugin.PyEndpoint = IcePyEndpoint:addPyEndpointSupport

PyEndpoint.Module = IceXBee
PyEndpoint.Factory = EndpointFactoryI

# XBee should be on API mode, and API level should be 1
XBee.Device = /dev/ttyUSB1
XBee.Speed = 9600

Adapter.Endpoints = xbee -p idm -n listener
