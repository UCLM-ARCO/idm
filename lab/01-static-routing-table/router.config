# -*- mode: conf; coding: utf-8 -*-

# PyEndpoint support
Ice.Plugin.PyEndpoint = IcePyEndpoint:addPyEndpointSupport
PyEndpoint.Module = IceXBee
PyEndpoint.Factory = EndpointFactoryI

# XBee endpoint; XBee should be on API mode, and API level should be 1
XBee.Device = /dev/ttyUSB0
XBee.Speed = 9600

# IDM router settings
Router.Adapter.Endpoints = xbee -p idm -n router
Router.Table.Path = router.table
