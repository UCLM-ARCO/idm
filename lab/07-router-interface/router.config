# -*- mode: conf; coding: utf-8 -*-

# Common Ice properties
Ice.ThreadPool.Client.SizeMax=10
Ice.ThreadPool.Server.SizeMax=10
# Ice.Trace.Network=3

Ice.Default.Locator = IceGrid/Locator -t:tcp -h pike.esi.uclm.es -p 4061
IceStorm.TopicManager.Proxy = ARCO-Services.IceStorm/TopicManager

# IDM router settings
Router.Adapter.Endpoints = tcp -h 127.0.0.1 -p 6140
Router.Table.Path = router.table
Router.Ids = AA01 | BB02
